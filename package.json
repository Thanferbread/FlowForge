{
  "name": "flowforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FlowForge 校园人流仿真与布局实验平台",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:offline": "npm run build && node scripts/build-offline.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "vitest run --config vitest.headless.config.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "jsdom": "25.0.1"
  }
}
